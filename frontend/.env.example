# Dedicated frontend environment variables (copy to frontend/.env if you want
# frontend config separated from the repository root .env)

# Backend REST API base URL (e.g. http://localhost:5000/api)
REACT_APP_API_URL=

# Socket.IO server URL (e.g. http://localhost:5000)
REACT_APP_SOCKET_URL=

# Optional Vite dev server port (defaults to 3000)
# FRONTEND_PORT=
