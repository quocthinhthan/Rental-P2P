# ==============================================================================
# Rental-P2P-MVP - Production Environment Template (.env.prod.example)
# Copy to `.env.prod` on the VPS and replace all placeholder values with real
# production secrets. NEVER commit `.env.prod` to Git.
# ==============================================================================

# --- Core Runtime ---
NODE_ENV=production
PORT=5000
# Generate with: openssl rand -hex 48
JWT_SECRET=replace_with_long_random_jwt_secret

# --- MongoDB Atlas (external managed database) ---
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/p2p_rental?retryWrites=true&w=majority

# --- Nginx & Cloudflare Tunnel ---
# Production runs behind Cloudflare Tunnel (no host ports 80/443 published).
NGINX_CONF_FILE=nginx.tunnel.conf
# Cloudflare Zero Trust Tunnel connector token (replace on VPS; NEVER commit real token)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# --- Public Domain & Frontend Build-time URLs ---
REACT_APP_API_URL=https://rental.thanquocthinh.id.vn/api
REACT_APP_SOCKET_URL=https://rental.thanquocthinh.id.vn
FRONTEND_URL=https://rental.thanquocthinh.id.vn

# --- RabbitMQ (internal Docker network, non-guest dedicated account) ---
RABBITMQ_ENABLED=true
RABBITMQ_DEFAULT_USER=rental_rabbit
# Avoid special URL characters or URL-encode them in RABBITMQ_URI below
RABBITMQ_DEFAULT_PASS=replace_with_strong_rabbitmq_password
RABBITMQ_URI=amqp://rental_rabbit:replace_with_strong_rabbitmq_password@rabbitmq:5672

# --- Cloudinary (media storage) ---
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret

# --- SMTP Email (Notification Worker) ---
# IMPORTANT: Google Cloud Compute Engine blocks outbound TCP port 25.
# You MUST use port 587 (STARTTLS) or 465 (SMTPS).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=replace_with_smtp_email@example.com
EMAIL_PASS=replace_with_smtp_app_password

# --- PDFKit Vietnamese Fonts (Debian Bookworm `fonts-liberation` exact paths) ---
PDF_FONT_REGULAR=/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf
PDF_FONT_BOLD=/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf

# --- VNPay Payment Gateway ---
VNP_TMN_CODE=replace_with_vnpay_tmn_code
VNP_HASH_SECRET=replace_with_vnpay_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=https://rental.thanquocthinh.id.vn/api/rentals/vnpay-return

# --- External AI Integrations (Viettel AI eKYC & Gemini Price Suggestion) ---
VIETTEL_AI_BASE_URL=https://viettelai.vn
VIETTEL_AI_TOKEN=replace_with_viettel_ai_token
# Comma-separated exact `verify_result` values confirmed from real Viettel AI `/ekyc/face_liveness` response
VIETTEL_AI_LIVENESS_ACCEPTED_VALUES=
# Optional minimum liveness score in [0, 1] (leave blank until confirmed against provider baseline)
VIETTEL_AI_LIVENESS_MIN_SCORE=
VIETTEL_AI_TIMEOUT_SECONDS=30

# --- eKYC Session, Liveness Continuity & Cryptographic Secrets ---
EKYC_SESSION_TTL_MINUTES=15
EKYC_LIVENESS_CONTINUITY_SECONDS=180
EKYC_MAX_DOCUMENT_ATTEMPTS=3
EKYC_MAX_LIVENESS_RETRIES=5
EKYC_POLICY_VERSION=2026.2-doc-liveness-5pose
# Generate dedicated 32+ byte secrets in production (e.g. openssl rand -hex 32)
EKYC_HMAC_SECRET=replace_with_dedicated_ekyc_hmac_secret
EKYC_ENCRYPTION_KEY=replace_with_dedicated_ekyc_encryption_secret

GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
